# 离线兜底的运行时镜像：linux/amd64 二进制在宿主机交叉编译好再 COPY 进来。
# 正常部署拉 CI 推到 GHCR 的镜像（见 Dockerfile）；只有目标机拉不到镜像时才
# 用这份，它不依赖构建机能拉到 node 与 golang 的镜像。
# 镜像里没有 easytier-cli：用它时 ET_CLI 留空，或者自己把 CLI 打进镜像。
#
# 基础镜像钉 manifest list digest（同 Dockerfile 的运行时阶段）。升级时先
# `podman pull docker.io/library/alpine:3.24.4`，再用
# `podman image inspect --format '{{index .RepoDigests 0}}'` 取新 digest 替换。
FROM docker.io/library/alpine:3.24.4@sha256:0f49f331d9212aff11b932863be4eb01cdf962969aa86dab7d1ee21ac6f5f52b

# curl 是 podman kube play 翻译 httpGet 探针时要用的：它把探针写成容器内的
# `curl -f`，镜像里没有 curl 就会一直探针失败，pod 每 90 秒被杀一次。
# 包版本与 Dockerfile 一致、随基础镜像钉死；升级 digest 后用
# `podman run --rm <image> apk policy <pkg>` 取新版本一并替换。
RUN apk --no-cache add ca-certificates=20261020-r0 tzdata=2026f-r0 curl=8.23.0-r0

WORKDIR /app
COPY mesh-server .
# COPY 保留源文件权限，从 Windows 传上去的二进制没有执行位。
RUN chmod 0755 /app/mesh-server

CMD ["./mesh-server"]
